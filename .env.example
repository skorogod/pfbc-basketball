# --- Telegram ---
BOT_TOKEN=123456:replace-me
# Telegram ID корневых админов через запятую, например 111,222 (узнать свой ID: @userinfobot).
# Остальных админов можно назначать в боте командой /admins.
ADMIN_TG_IDS=111111111

# polling — локальная разработка, webhook — prod
BOT_MODE=polling
# Для webhook: публичный HTTPS-адрес (домен, на который указывает Caddy)
DOMAIN=bot.example.com
WEBHOOK_BASE_URL=https://bot.example.com
# Случайные строки: openssl rand -hex 32
WEBHOOK_PATH_SECRET=replace-with-random-hex
WEBHOOK_SECRET_TOKEN=replace-with-random-hex

# --- PostgreSQL ---
POSTGRES_USER=pfbc
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=pfbc
# Для локального запуска вне docker compose (в compose URL собирается автоматически)
DATABASE_URL=postgresql+asyncpg://pfbc:replace-me@localhost:5432/pfbc

# --- Прочее ---
DEFAULT_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=14
